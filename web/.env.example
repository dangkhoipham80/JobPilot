# Web Dashboard config. Copy to web/.env.local and adjust.

# Must match JOBPILOT_API_TOKEN in the backend .env. Generate one with:
#   python -c "from jobpilot.api.security import generate_token; print(generate_token())"
# The backend refuses to start on a placeholder or anything under 20 characters.
#
# Note this value is compiled into the bundle by Vite, so anyone who can load
# the dashboard can read it. That is fine only because reaching the dashboard
# requires being on the Tailnet — see jobpilot/api/CLAUDE.md.
VITE_API_TOKEN=changeme

# Normally leave unset: the bundle calls /api on whatever origin served it, which
# is the Vite dev server (proxied) in development and FastAPI in deployment.
# Set it only to aim a dev bundle at a backend on a different host.
# VITE_API_BASE=http://127.0.0.1:8000/api
