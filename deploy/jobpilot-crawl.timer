[Unit]
Description=Crawl job boards twice a day

[Timer]
# Vietnamese boards post during office hours; twice a day catches the morning
# batch and the afternoon one without hammering anybody.
#
# These are LOCAL times, so the host's timezone must be set — DEPLOY.md §2 runs
# `timedatectl set-timezone Asia/Ho_Chi_Minh`, and a VPS that ships as UTC would
# otherwise crawl at 15:30 and 01:30 local.
#
# The timezone is deliberately not written inline here. There is no `Timezone=`
# directive in [Timer] (systemd would ignore the unknown key and quietly stay on
# UTC), and the `OnCalendar=08:30 Asia/Ho_Chi_Minh` suffix form is recent enough
# that older systemd fails to parse it — and has been reported to be silently
# treated as UTC on some distributions. Both failure modes are a seven-hour
# offset with no error, which nobody notices until the jobs stop looking fresh.
OnCalendar=08:30
OnCalendar=18:30

# Spread the start so every JobPilot box on earth doesn't hit ITviec at the same
# second, and so a board can't fingerprint the schedule.
RandomizedDelaySec=20min

# Run on the next boot if the machine was off when the timer was due. The whole
# point of moving off the laptop was not missing runs.
Persistent=true

[Install]
WantedBy=timers.target
