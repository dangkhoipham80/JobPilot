[Unit]
Description=JobPilot backup (Postgres dump + CV export)
After=postgresql.service

[Service]
Type=oneshot
User=jobpilot
Group=jobpilot
WorkingDirectory=/opt/jobpilot
ExecStart=/opt/jobpilot/deploy/backup.sh
# backup.sh writes outside the app directory by design — a backup on the same
# disk path as the thing it backs up survives fewer accidents than it looks.
ReadWritePaths=/var/backups/jobpilot
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
