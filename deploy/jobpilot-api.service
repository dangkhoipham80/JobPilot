[Unit]
Description=JobPilot API + dashboard
# Docker is NOT a dependency any more. The default LaTeX engine is tectonic, a
# plain binary with no daemon (cv.engine = auto|tectonic|docker), so a box built
# from DEPLOY.md has no docker.service at all — and `Requires=` on a unit that
# does not exist makes systemd refuse to start *this* one, taking the entire API
# and dashboard down over a PDF builder. Left as a soft `Wants=` so a box
# deliberately set to cv.engine: docker still gets dockerd ordered first, without
# that being fatal for everyone else.
After=network-online.target postgresql.service docker.service
Wants=network-online.target docker.service

[Service]
Type=exec
User=jobpilot
Group=jobpilot
WorkingDirectory=/opt/jobpilot
EnvironmentFile=/opt/jobpilot/.env

# --workers 1 is mandatory, not tuning. The task queue is a ThreadPoolExecutor
# inside this process, so a second worker is a second queue with its own
# WebSocket manager: the same job gets tailored twice and progress goes to a
# dashboard that isn't listening. Both failures are silent.
# No --reload either: it spawns a reloader parent, which doubles the queue the
# same way.
ExecStart=/opt/jobpilot/.venv/bin/uvicorn jobpilot.api.main:app \
    --host 127.0.0.1 --port 8000 --workers 1

# Bound to loopback on purpose. Reachable from other devices only through
# `tailscale serve`, which terminates TLS and proxies back here — so there is no
# firewall port to open and nothing listening on a public interface.

Restart=always
RestartSec=5

# The process needs to write out/ (built PDFs) and jobpilot/config.local.yaml,
# and to read .env. Nothing else on the box is its business.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/jobpilot/out /opt/jobpilot/jobpilot

[Install]
WantedBy=multi-user.target
