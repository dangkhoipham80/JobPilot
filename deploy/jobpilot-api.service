[Unit]
Description=JobPilot API + dashboard
# No dependency on docker.service, and that is deliberate: on this host the CV
# is compiled by the xelatex in PATH (cv.build_backend), because the builder
# image is amd64-only and this machine is arm64. Requiring a unit that does not
# exist here would stop the API from starting at all.
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=jobpilot
Group=jobpilot
WorkingDirectory=/opt/jobpilot
EnvironmentFile=/opt/jobpilot/.env

# Set explicitly because xelatex needs somewhere to write its caches: fontconfig
# indexes the bundled Roboto/FontAwesome TTFs into ~/.cache/fontconfig, and TeX
# Live writes ~/.texlive*/texmf-var on first run. `adduser --system` frequently
# leaves a home directory that does not exist or is not writable, and the
# resulting failure is a LaTeX error about fonts rather than about permissions —
# which sends you looking in entirely the wrong place.
Environment=HOME=/opt/jobpilot
Environment=TEXMFVAR=/opt/jobpilot/.texmf-var

# --workers 1 is mandatory, not tuning. The task queue is a ThreadPoolExecutor
# inside this process, so a second worker is a second queue with its own
# WebSocket manager: the same job gets tailored twice and progress goes to a
# dashboard that isn't listening. Both failures are silent.
# No --reload either: it spawns a reloader parent, which doubles the queue the
# same way.
ExecStart=/opt/jobpilot/.venv/bin/uvicorn jobpilot.api.main:app \
    --host 127.0.0.1 --port 8000 --workers 1

# Bound to loopback on purpose. Reachable from other devices only through
# `tailscale serve`, which terminates TLS and proxies back here — so there is no
# firewall port to open and nothing listening on a public interface.

Restart=always
RestartSec=5

# The process needs to write out/ (built PDFs) and jobpilot/config.local.yaml,
# and to read .env. Nothing else on the box is its business.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/jobpilot/out /opt/jobpilot/jobpilot /opt/jobpilot/.cache /opt/jobpilot/.texmf-var

[Install]
WantedBy=multi-user.target
