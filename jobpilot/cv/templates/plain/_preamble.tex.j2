%!TEX TS-program = xelatex
%!TEX encoding = UTF-8 Unicode
% Generated by JobPilot CV Studio -- do not edit by hand.
% Source of truth is the structured JSON (cv_versions.content); edit that instead.
%
% The "plain" template: one column, no colour, no icons, no custom class.
% It exists to be *read by a machine* -- portal ATS parsers that mangle
% multi-column or icon-heavy PDFs -- so every choice here is subordinate to
% "does the text layer come out in reading order". Built on stock `article`
% plus packages any TeX Live has, which is why it needs no .cls of its own
% (template.json lists `fonts` as its only asset).
%
% Shared by cv.tex.j2 and cover_letter.tex.j2 so the two documents can't drift.

%-------------------------------------------------------------------------------
% CONFIGURATIONS
%-------------------------------------------------------------------------------
\documentclass[11pt, a4paper]{article}

\usepackage[left=1.6cm, top=1.4cm, right=1.6cm, bottom=1.6cm]{geometry}
\usepackage{fontspec}
\usepackage{enumitem}
\usepackage{titlesec}
\usepackage[hidelinks]{hyperref}
\usepackage{microtype}

% Roboto ships in the repo's fonts/ and covers Vietnamese; the stock TeX fonts
% do not, and a missing glyph here is a silently blank character in the PDF.
\setmainfont{Roboto}[
  Path            = << doc.theme.font_dir >>,
  Extension       = .ttf,
  UprightFont     = *-Regular,
  BoldFont        = *-Bold,
  ItalicFont      = *-Italic,
  BoldItalicFont  = *-BoldItalic,
]

%-------------------------------------------------------------------------------
% CUSTOM MACROS
%-------------------------------------------------------------------------------
% cv/latex.py emits \tech, \techfe and \hreficon for the inline markup subset.
% This template must define all three or every CV using it fails to build --
% here they collapse to plain emphasis, because colour and icons are exactly
% what an ATS parser is bad at. doc.theme.color is deliberately ignored.
\newcommand{\tech}[1]{\textbf{#1}}
\newcommand{\techfe}[1]{\textbf{#1}}
\newcommand{\hreficon}[2]{\href{#1}{#2}}

\newcommand{\cvsep}{\hspace{0.4em}\textbullet{}\hspace{0.4em}}

% Spacing is tuned against the sample CV: the styled template fits it on one
% page, and a "plain" variant that silently needs two is a worse CV, not a
% plainer one. Entry gaps are explicit \vspace (see section_entries) because
% \parskip is 0 here -- a blank line in the .tex must not be load-bearing.
\titleformat{\section}{\large\bfseries}{}{0pt}{\MakeUppercase}[\titlerule]
\titlespacing*{\section}{0pt}{8pt}{3pt}
\setlist[itemize]{leftmargin=1.2em, itemsep=0pt, topsep=1pt, parsep=0pt}

\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

%-------------------------------------------------------------------------------
% PERSONAL INFORMATION
%-------------------------------------------------------------------------------
<#
  The contact line is assembled here rather than in the body so the CV and the
  cover letter carry an identical identity block. Handles are expanded to the
  full URL text (github.com/<handle>) instead of an icon: the icon is a glyph an
  ATS drops on the floor, the URL is text it can index.
#>
<% set bits = [] %>
<% if h.mobile %><% set _ = bits.append(h.mobile|tex) %><% endif %>
<% if h.email %><% set _ = bits.append('\\href{mailto:' ~ h.email|url ~ '}{' ~ h.email|tex ~ '}') %><% endif %>
<% if h.address %><% set _ = bits.append(h.address|tex) %><% endif %>
<% if h.homepage %><% set _ = bits.append('\\href{https://' ~ h.homepage|url ~ '}{' ~ h.homepage|tex ~ '}') %><% endif %>
<% if h.github %><% set _ = bits.append('\\href{https://github.com/' ~ h.github|url ~ '}{github.com/' ~ h.github|tex ~ '}') %><% endif %>
<% if h.linkedin %><% set _ = bits.append('\\href{https://linkedin.com/in/' ~ h.linkedin|url ~ '}{linkedin.com/in/' ~ h.linkedin|tex ~ '}') %><% endif %>
<% if h.extra_info %><% set _ = bits.append('\\href{' ~ h.extra_info.url|url ~ '}{' ~ h.extra_info.label|tex ~ '}') %><% endif %>
\newcommand{\makeplainheader}{%
  \begingroup
  \raggedright
  {\LARGE\bfseries << h.first_name|tex >> << h.last_name|tex >>}\par
<% if h.position %>
  \vspace{3pt}
  {\large << h.position|tex >>}\par
<% endif %>
<% if bits %>
  \vspace{4pt}
  {\small << bits|join('\\cvsep{}') >>}\par
<% endif %>
<% if h.quote %>
  \vspace{4pt}
  {\small\itshape << h.quote|tex >>}\par
<% endif %>
  \endgroup
  \vspace{2pt}
}
